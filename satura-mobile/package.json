{
  "name": "satura",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Satura — Aplicativo mobile para criação de paletas de cores personalizadas e extração de imagens",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "babel-preset-expo": "~58.0.0",
    "escape-string-regexp": "^5.0.0",
    "expo": "^58.0.26",
    "expo-asset": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "fast-deep-equal": "^3.1.3",
    "jpeg-js": "^0.4.4",
    "lucide-react-native": "^1.79.0",
    "nanoid": "^3.3.20",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "escape-string-regexp",
          "fast-deep-equal",
          "jpeg-js",
          "nanoid",
          "query-string"
        ]
      }
    }
  }
}
