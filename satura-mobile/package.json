{
  "name": "satura",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Satura — Aplicativo mobile para criação de paletas de cores personalizadas e extração de imagens",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "babel-preset-expo": "~12.0.0",
    "escape-string-regexp": "^5.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-image": "~2.0.0",
    "expo-image-manipulator": "~13.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "fast-deep-equal": "^3.1.3",
    "jpeg-js": "^0.4.4",
    "nanoid": "^3.3.20",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "escape-string-regexp",
          "fast-deep-equal",
          "jpeg-js",
          "nanoid",
          "query-string"
        ]
      }
    }
  }
}
