{
  "name": "satura",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Satura — Aplicativo mobile para criação de paletas de cores personalizadas e extração de imagens",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~57.0.0",
    "escape-string-regexp": "^5.0.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.20",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "fast-deep-equal": "^3.1.3",
    "jpeg-js": "^0.4.4",
    "nanoid": "^3.3.20",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "escape-string-regexp",
          "fast-deep-equal",
          "jpeg-js",
          "nanoid",
          "query-string"
        ]
      }
    }
  }
}
